---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "American English Method",
  description = "Learn natural, contemporary American English through real-life situations."
} = Astro.props;
const pageTitle = title === "American English Method" ? title : `${title} | American English Method`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1929" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/american-english-method/" aria-label="American English Method home">
          <span class="brand-mark">A</span>
          <span class="brand-name">American English Method</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="/american-english-method/#method">The Method</a>
          <a href="/american-english-method/#directions">Learning Directions</a>
          <a href="/american-english-method/#visual-lessons">Visual Lessons</a>
        </nav>
        <span class="header-note">Living American English</span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span><strong>American English Method</strong> · A practical learning system</span>
        <span>See → Understand → Describe → Speak</span>
      </div>
    </footer>
  </body>
</html>
