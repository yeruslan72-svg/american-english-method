---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { marked } from "marked";
import { lessons, sections } from "../../../data/content";

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { section: lesson.section, slug: lesson.slug },
    props: { lesson }
  }));
}
const { lesson } = Astro.props;
const section = sections.find((item) => item.id === lesson.section);
const sectionLessons = lessons.filter((item) => item.section === lesson.section);
const lessonIndex = sectionLessons.findIndex((item) => item.id === lesson.id);
const previousLesson = lessonIndex > 0 ? sectionLessons[lessonIndex - 1] : undefined;
const nextLesson = lessonIndex >= 0 && lessonIndex < sectionLessons.length - 1 ? sectionLessons[lessonIndex + 1] : undefined;
const markdown = lesson.markdown.replace(/(!\[[^\]]*\]\()((?:\.\.\/)+images\/)/g, "$1/american-english-method/images/");
const headingSource = [...markdown.matchAll(/^#{2,3}\s+(.+)$/gm)].map((match, index) => {
  const plain = match[1].replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/[*_~]/g, "").trim();
  const base = plain.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "section-" + (index + 1);
  return { text: plain, id: base + "-" + (index + 1), level: match[0].startsWith("###") ? 3 : 2 };
});
let headingIndex = 0;
const html = (marked.parse(markdown) as string).replace(/<h([23])>/g, (_match, level) => {
  const heading = headingSource[headingIndex++];
  if (!heading) return "<h" + level + ">";
  const normalized = heading.text.toLowerCase();
  const layer = normalized.includes("nationwide") ? "nationwide-layer" : normalized.includes("southern") ? "southern-layer" : normalized.includes("connected speech") ? "speech-layer" : "";
  return '<h' + level + ' id="' + heading.id + '"' + (layer ? ' class="' + layer + '"' : "") + '>';
});
---
<BaseLayout title={lesson.displayTitle} description={lesson.description}>
  <article class="section lesson-page" id="top">
    <div class="container">
      <a class="back-link" href={"/american-english-method/learn/" + lesson.section + "/"}>← {section?.title ?? "Learning direction"}</a>
      <div class="lesson-meta">
        <span class="eyebrow">{section?.title}</span>
        <span class="source-path">{lesson.source}</span>
      </div>
      {headingSource.length > 2 && (
        <nav class="lesson-toc" aria-label="Lesson contents">
          <details open>
            <summary>In this lesson</summary>
            <ol>
              {headingSource.map((heading) => (
                <li class:list={{ "toc-subsection": heading.level === 3 }}>
                  <a href={"#" + heading.id}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )}
      <div class="markdown-content" set:html={html} />
      <nav class="lesson-navigation" aria-label="Lesson navigation">
        {previousLesson ? (
          <a class="lesson-nav-item" href={"/american-english-method/learn/" + previousLesson.section + "/" + previousLesson.slug + "/"}>
            <span>← Previous lesson</span><strong>{previousLesson.displayTitle}</strong>
          </a>
        ) : <span />}
        {nextLesson ? (
          <a class="lesson-nav-item next" href={"/american-english-method/learn/" + nextLesson.section + "/" + nextLesson.slug + "/"}>
            <span>Next lesson →</span><strong>{nextLesson.displayTitle}</strong>
          </a>
        ) : (
          <a class="lesson-nav-item next" href={"/american-english-method/learn/" + lesson.section + "/"}>
            <span>All lessons</span><strong>{section?.title}</strong>
          </a>
        )}
      </nav>
      <div class="lesson-end"><a href="#top">Back to top ↑</a></div>
    </div>
  </article>
</BaseLayout>
