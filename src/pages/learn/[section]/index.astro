---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { sections, lessons } from "../../../data/content";

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.id }, props: { section } }));
}
const { section } = Astro.props;
const sectionLessons = lessons.filter((lesson) => lesson.section === section.id);
---
<BaseLayout title={section.title} description={section.description}>
  <section class="section">
    <div class="container">
      <a class="back-link" href="/american-english-method/">← Home</a>
      <div class="eyebrow">Learning direction</div>
      <h1 class="page-title">{section.title}</h1>
      <p class="page-lead">{section.intro}</p>
      {section.id === "texas-english" && (
        <figure class="texas-visual">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/6/65/Texascowboys.jpg"
            alt="Two working cowboys on horseback near Benjamin, Texas, wearing wide-brimmed hats and carrying ropes"
            loading="eager"
            decoding="async"
          />
          <figcaption>
            <span class="texas-tagline">Real Texas. Real People. Real English.</span>
            <span class="texas-credit">
              Photo: <a href="https://commons.wikimedia.org/wiki/File:Texascowboys.jpg" target="_blank" rel="noopener noreferrer">Pschemp, “Texascowboys.jpg” (2006)</a> ·
              <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>
              · Wikimedia Commons
            </span>
          </figcaption>
        </figure>
      )}
      {section.id === "appalachian-english" && (
        <figure class="appalachian-visual">
          <img
            src="https://tile.loc.gov/storage-services/service/pnp/fsa/8a16000/8a16600/8a16694v.jpg"
            alt="Street musicians in Maynardville, Tennessee, in October 1935; a man plays guitar while other local musicians sit beside him"
            loading="eager"
            decoding="async"
          />
          <figcaption>
            <span class="appalachian-tagline">Real Appalachia. Real People. Real Voices.</span>
            <span class="appalachian-credit">
              Photo: <a href="https://commons.wikimedia.org/wiki/File:Maynardville-musicians-tn1.jpg" target="_blank" rel="noopener noreferrer">Ben Shahn, “Street musicians in Maynardville, Tennessee” (October 1935)</a> ·
              <a href="https://www.loc.gov/item/fsa.8a16694/" target="_blank" rel="noopener noreferrer">Library of Congress</a> ·
              Public domain (U.S. federal government work)
            </span>
          </figcaption>
        </figure>
      )}
      <p class="catalogue-count">{sectionLessons.length} {sectionLessons.length === 1 ? "learning resource" : "learning resources"} in this direction.</p>
      {sectionLessons.length > 0 ? (
        <div class="lesson-list">
          {sectionLessons.map((lesson) => (
            <a class="lesson-row" href={`/american-english-method/learn/${lesson.section}/${lesson.slug}/`}>
              <div>
                <span class="lesson-type">{lesson.type.replaceAll("-", " ")}</span>
                <h2>{lesson.displayTitle}</h2>
                <p>{lesson.description}</p>
              </div>
              <span class="lesson-arrow">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="catalogue-note">
          <h2>The learning direction is part of the course.</h2>
          <p>The existing materials for this direction will be connected to the website catalogue in the next integration pass. The original Markdown lessons remain in the repository.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>


<style>
  .texas-visual {
    margin: 2rem 0 2.25rem;
    overflow: hidden;
    border: 1px solid rgba(190, 160, 105, 0.28);
    border-radius: 14px;
    background: #101d2d;
  }
  .texas-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 48%;
  }
  .texas-visual figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 0.85rem 1rem;
  }
  .texas-tagline {
    color: #e8c98f;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.045em;
  }
  .texas-credit {
    color: #b9c3cf;
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .texas-credit a {
    color: #e1e8f0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 640px) {
    .texas-visual { margin: 1.5rem 0 1.75rem; border-radius: 10px; }
    .texas-visual img { aspect-ratio: 4 / 3; }
    .texas-visual figcaption { display: grid; gap: 0.35rem; }
  }
  .appalachian-visual {
    margin: 2rem 0 2.25rem;
    overflow: hidden;
    border: 1px solid rgba(190, 160, 105, 0.28);
    border-radius: 14px;
    background: #101d2d;
  }
  .appalachian-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 48%;
  }
  .appalachian-visual figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 0.85rem 1rem;
  }
  .appalachian-tagline {
    color: #e8c98f;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.045em;
  }
  .appalachian-credit {
    color: #b9c3cf;
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .appalachian-credit a {
    color: #e1e8f0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

</style>
