---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { marked } from "marked";
import markdown from "../../../content/jack-london.md?raw";

const html = marked.parse(markdown) as string;
const headings = [...markdown.matchAll(/^#{2,3}\s+(.+)$/gm)].map((match, index) => {
  const text = match[1].trim();
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") + "-" + (index + 1);
  return { text, id, level: match[0].startsWith("###") ? 3 : 2 };
});
let headingIndex = 0;
const rendered = html.replace(/<h([23])>/g, (_match, level) => {
  const heading = headings[headingIndex++];
  return heading ? '<h' + level + ' id="' + heading.id + '">' : "<h" + level + ">";
});
---
<BaseLayout title="Meet Jack London" description="Explore Jack London's life, The Call of the Wild, The Sea-Wolf, Martin Eden, and practical American English.">
  <article class="section lesson-page" id="top">
    <div class="container">
      <a class="back-link" href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a>
      <div class="lesson-meta">
        <span class="eyebrow">AMERICAN WRITERS</span>
        <span class="source-path">JACK LONDON · 1876–1916</span>
      </div>
      <figure class="london-hero">
        <img
          src="https://cdn.loc.gov/service/pnp/agc/7a10000/7a10200/7a10260r.jpg"
          alt="Portrait photograph of Jack London by Arnold Genthe"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Jack London, portrait photograph by Arnold Genthe, from the Genthe photograph collection.
          Library of Congress, Prints and Photographs Division.
          <a href="https://www.loc.gov/pictures/item/2018704322/" target="_blank" rel="noreferrer">View the original archive record</a>.
          Rights Advisory: No known restrictions on publication.
        </figcaption>
      </figure>
      <figure class="london-snark">
        <img
          src="https://commons.wikimedia.org/wiki/Special:FilePath/Jack_London_the_building_of_The_Snark_1906.jpg"
          alt="Jack London at the building of his sailing vessel the Snark in 1906"
          loading="lazy"
        />
        <figcaption>
          Jack London at the building of the sailing vessel <em>Snark</em>, 1906.
          From <em>The Book of Jack London</em> by Charmian London, published in 1921.
          <a href="https://commons.wikimedia.org/wiki/File:Jack_London_the_building_of_The_Snark_1906.jpg" target="_blank" rel="noreferrer">Image record and licensing information</a>.
          Public domain in the United States; copyright status may differ elsewhere.
        </figcaption>
      </figure>
      <nav class="lesson-toc" aria-label="Page contents">
        <details>
          <summary>In this feature</summary>
          <ol>
            {headings.map((heading) => (
              <li class:list={{ "toc-subsection": heading.level === 3 }}>
                <a href={"#" + heading.id}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
      <div class="markdown-content" set:html={rendered} />
      <div class="lesson-end"><a href="#top">Back to top ↑</a><a href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a></div>
    </div>
  </article>
</BaseLayout>
<style>
.london-hero,.london-snark{max-width:760px;margin:2rem auto 2.5rem}
.london-hero img{display:block;width:100%;max-width:360px;max-height:480px;height:auto;margin:0 auto;object-fit:contain;background:#f4f1e9;border-radius:6px}
.london-snark img{display:block;width:100%;max-height:540px;height:auto;margin:0 auto;object-fit:contain;background:#f4f1e9;border-radius:6px}
.london-hero figcaption,.london-snark figcaption{margin:.65rem auto 0;max-width:650px;color:#6b7280;font-size:.85rem;line-height:1.55;text-align:center}
.london-hero figcaption a,.london-snark figcaption a{color:#8b6b32;text-decoration:underline;text-underline-offset:3px}
</style>
