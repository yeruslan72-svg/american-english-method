---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { marked } from "marked";
import markdown from "../../../content/james-fenimore-cooper.md?raw";

const html = marked.parse(markdown) as string;
const headings = [...markdown.matchAll(/^#{2,3}\s+(.+)$/gm)].map((match, index) => {
  const text = match[1].trim();
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") + "-" + (index + 1);
  return { text, id, level: match[0].startsWith("###") ? 3 : 2 };
});
let headingIndex = 0;
const rendered = html.replace(/<h([23])>/g, (_match, level) => {
  const heading = headings[headingIndex++];
  return heading ? '<h' + level + ' id="' + heading.id + '">' : "<h" + level + ">";
});
---
<BaseLayout title="Meet James Fenimore Cooper" description="Explore James Fenimore Cooper, the Leatherstocking Tales, The Last of the Mohicans, American frontier fiction, and practical English.">
  <article class="section lesson-page" id="top">
    <div class="container">
      <a class="back-link" href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a>
      <div class="lesson-meta">
        <span class="eyebrow">AMERICAN WRITERS</span>
        <span class="source-path">JAMES FENIMORE COOPER · 1789–1851</span>
      </div>
      <figure class="cooper-hero">
        <img
          src="https://upload.wikimedia.org/wikipedia/commons/f/fa/James_Fenimore_Cooper_by_Jarvis.jpg"
          alt="Portrait of James Fenimore Cooper painted by John Wesley Jarvis in 1822"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          James Fenimore Cooper, portrait by John Wesley Jarvis, 1822.
          The original painting is held by the New York State Historical Association.
          <a href="https://commons.wikimedia.org/wiki/File:James_Fenimore_Cooper_by_Jarvis.jpg" target="_blank" rel="noreferrer">View image record and licensing information</a>.
          Public-domain reproduction in the United States.
        </figcaption>
      </figure>
      <section class="cooper-character-gallery" aria-label="Historical illustrations of Cooper's characters">
        <figure>
          <img
            src="https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/American_Pioneer_Life_pg_116_Combat_between_Chingachgook_and_the_Iroquois.png/500px-American_Pioneer_Life_pg_116_Combat_between_Chingachgook_and_the_Iroquois.png"
            alt="Historical engraving titled Combat between Chingachgook and the Iroquois, illustrated by Michał Elwiro Andriolli"
            loading="lazy"
          />
          <figcaption>
            <strong>Combat between Chingachgook and the Iroquois</strong> — illustration by Michał Elwiro Andriolli, engraved by Edmund Evans, published in <em>Historical Stories of American Pioneer Life</em> (1897).
            <a href="https://commons.wikimedia.org/wiki/File:American_Pioneer_Life_pg_116_Combat_between_Chingachgook_and_the_Iroquois.png" target="_blank" rel="noreferrer">View the original image and public-domain record</a>.
          </figcaption>
        </figure>
        <figure>
          <img
            src="https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/American_Pioneer_Life_pg_18_Hurry_Harry_and_Deerslayer.png/500px-American_Pioneer_Life_pg_18_Hurry_Harry_and_Deerslayer.png"
            alt="Natty Bumppo, known as Deerslayer, standing in a canoe with Hurry Harry"
            loading="lazy"
          />
          <figcaption>
            <strong>Hurry Harry and Deerslayer</strong> — illustration by Michał Elwiro Andriolli, engraved by Edmund Evans, published in <em>Historical Stories of American Pioneer Life</em> (1897).
            <a href="https://commons.wikimedia.org/wiki/File:American_Pioneer_Life_pg_18_Hurry_Harry_and_Deerslayer.png" target="_blank" rel="noreferrer">View the original image and public-domain record</a>.
          </figcaption>
        </figure>
      </section>
      <p class="visual-note">These are historical nineteenth-century interpretations of fictional characters, not documentary portraits. Both reproductions are identified as public domain in the United States; copyright status can vary by country.</p>
      <nav class="lesson-toc" aria-label="Page contents">
        <details>
          <summary>In this feature</summary>
          <ol>
            {headings.map((heading) => (
              <li class:list={{ "toc-subsection": heading.level === 3 }}>
                <a href={"#" + heading.id}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
      <div class="markdown-content" set:html={rendered} />
      <div class="lesson-end"><a href="#top">Back to top ↑</a><a href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a></div>
    </div>
  </article>
</BaseLayout>
<style>
.cooper-hero{max-width:760px;margin:2rem auto 2.5rem}
.cooper-hero img{display:block;width:100%;max-width:390px;max-height:520px;height:auto;margin:0 auto;object-fit:contain;background:#f4f1e9;border-radius:6px}
.cooper-hero figcaption{margin:.65rem auto 0;max-width:650px;color:#6b7280;font-size:.85rem;line-height:1.55;text-align:center}
.cooper-hero figcaption a{color:#8b6b32;text-decoration:underline;text-underline-offset:3px}
.cooper-character-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin:2rem 0 2.5rem}
.cooper-character-gallery figure{margin:0;padding:1rem;background:#f7f5f0;border:1px solid #e2ded5}
.cooper-character-gallery img{display:block;width:100%;height:430px;object-fit:contain;background:#fff}
.cooper-character-gallery figcaption{margin-top:.8rem;color:#596575;font-size:.85rem;line-height:1.6}
.cooper-character-gallery figcaption a{color:#8b6b32;text-decoration:underline;text-underline-offset:3px}\n.visual-note{max-width:850px;margin:-1.2rem auto 2rem;color:#7a8490;font-size:.82rem;line-height:1.55;text-align:center}
@media(max-width:700px){.cooper-character-gallery{grid-template-columns:1fr}.cooper-character-gallery img{height:auto;max-height:560px}}
</style>
