---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { marked } from "marked";
import markdown from "../../../content/henry-david-thoreau.md?raw";

const html = marked.parse(markdown) as string;
const headings = [...markdown.matchAll(/^#{2,3}\s+(.+)$/gm)].map((match, index) => {
  const text = match[1].trim();
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") + "-" + (index + 1);
  return { text, id, level: match[0].startsWith("###") ? 3 : 2 };
});
let headingIndex = 0;
const rendered = html.replace(/<h([23])>/g, (_match, level) => {
  const heading = headings[headingIndex++];
  return heading ? '<h' + level + ' id="' + heading.id + '">' : "<h" + level + ">";
});
---
<BaseLayout title="Meet Henry David Thoreau" description="Explore Henry David Thoreau, Walden, Civil Disobedience, nature writing, and practical American English.">
  <article class="section lesson-page" id="top">
    <div class="container">
      <a class="back-link" href="/american-english-method/learn/culture-arts/">← American Culture &amp; Arts</a>
      <div class="lesson-meta">
        <span class="eyebrow">AMERICAN WRITERS</span>
        <span class="source-path">HENRY DAVID THOREAU · 1817–1862</span>
      </div>
      <figure class="thoreau-hero">
        <img
          src="https://tile.loc.gov/storage-services/service/pnp/cph/3a00000/3a02000/3a02100/3a02153r.jpg"
          alt="Henry David Thoreau, head-and-shoulders archival portrait, facing slightly right"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Henry David Thoreau, archival head-and-shoulders portrait, facing slightly right. Library of Congress, Prints and Photographs Division.
          <a href="https://www.loc.gov/pictures/item/95513963/" target="_blank" rel="noreferrer">View the Library of Congress record and rights information</a>.
          See the Library of Congress catalogue record for image details and rights information.
        </figcaption>
      </figure>
      <section class="thoreau-gallery" aria-labelledby="thoreau-gallery-title">
        <h2 id="thoreau-gallery-title">Walden Pond: The Place Behind the Book</h2>
        <p class="gallery-intro">These archival images show the landscape associated with Thoreau's experiment. They are historical photographs of Walden Pond, not photographs taken during Thoreau's lifetime.</p>
        <div class="thoreau-grid">
          <figure>
            <a href="https://www.loc.gov/pictures/item/2017728554/" target="_blank" rel="noreferrer">
              <img src="https://tile.loc.gov/storage-services/service/pnp/fsa/8a14000/8a14700/8a14779v.jpg" alt="Walden Pond, the place associated with Thoreau, photographed in September 1937" loading="lazy" />
            </a>
            <figcaption>
              <strong>At Walden Pond, haunt of Thoreau, 1937</strong>
              Photograph by Edwin Locke, September 1937. Library of Congress, Farm Security Administration collection. The archive records no known restrictions on publication.
              <a href="https://www.loc.gov/pictures/item/2017728554/" target="_blank" rel="noreferrer">Original image record</a>.
            </figcaption>
          </figure>
          <figure>
            <a href="https://www.loc.gov/item/2016814387/" target="_blank" rel="noreferrer">
              <img src="https://tile.loc.gov/storage-services/service/pnp/det/4a22000/4a22600/4a22665v.jpg" alt="Thoreau's Cove at Walden Pond, Concord, Massachusetts, circa 1908" loading="lazy" />
            </a>
            <figcaption>
              <strong>Thoreau's Cove, Concord, Massachusetts, circa 1908</strong>
              Historical photograph by the Detroit Publishing Company. The Library of Congress record states that there are no known restrictions on publication.
              <a href="https://www.loc.gov/item/2016814387/" target="_blank" rel="noreferrer">Original image record</a>.
            </figcaption>
          </figure>
        </div>
        <p class="gallery-note">The photographs were made decades after Thoreau's stay at Walden Pond. They help readers picture the setting, but they should not be mistaken for contemporary photographs of the author.</p>
      </section>
      <nav class="lesson-toc" aria-label="Page contents">
        <details>
          <summary>In this feature</summary>
          <ol>
            {headings.map((heading) => (
              <li class:list={{ "toc-subsection": heading.level === 3 }}>
                <a href={"#" + heading.id}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
      <div class="markdown-content" set:html={rendered} />
      <div class="lesson-end"><a href="#top">Back to top ↑</a><a href="/american-english-method/learn/culture-arts/">← American Culture &amp; Arts</a></div>
    </div>
  </article>
</BaseLayout>
<style>
.thoreau-hero{max-width:760px;margin:2rem auto 2.5rem}
.thoreau-hero img{display:block;width:100%;max-width:480px;max-height:600px;height:auto;margin:0 auto;object-fit:contain;background:#f4f1e9;border-radius:7px}
.thoreau-hero figcaption{margin:.7rem auto 0;max-width:680px;color:#6b7280;font-size:.85rem;line-height:1.6;text-align:center}
.thoreau-hero figcaption a,.thoreau-grid figcaption a{color:#8b6b32;text-decoration:underline;text-underline-offset:3px}
.thoreau-gallery{margin:3.5rem auto;max-width:1050px}
.thoreau-gallery h2{text-align:center;margin-bottom:.6rem}
.gallery-intro,.gallery-note{max-width:790px;margin:0 auto 1.5rem;text-align:center;color:#6b7280;line-height:1.65}
.thoreau-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;align-items:start}
.thoreau-grid figure{margin:0;min-width:0}
.thoreau-grid figure>a{display:flex;align-items:center;justify-content:center;min-height:250px;max-height:430px;overflow:hidden;background:#f4f1e9;border-radius:7px}
.thoreau-grid img{display:block;width:100%;height:100%;max-height:430px;object-fit:contain}
.thoreau-grid figcaption{padding:.75rem .15rem 0;color:#6b7280;font-size:.86rem;line-height:1.6}
.thoreau-grid figcaption strong{display:block;color:var(--color-text,#273244);margin-bottom:.35rem}
.thoreau-grid figcaption a{display:inline-block;margin-top:.35rem}
.gallery-note{font-size:.82rem;margin-top:1.25rem}
@media(max-width:700px){.thoreau-grid{grid-template-columns:1fr;gap:1.8rem}.thoreau-grid figure>a{min-height:180px;max-height:360px}.thoreau-grid figure{max-width:560px;margin:0 auto;width:100%}}
</style>
