---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { marked } from "marked";
import markdown from "../../../content/mark-twain.md?raw";

const html = marked.parse(markdown) as string;
const headings = [...markdown.matchAll(/^#{2,3}\s+(.+)$/gm)].map((match, index) => {
  const text = match[1].trim();
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") + "-" + (index + 1);
  return { text, id, level: match[0].startsWith("###") ? 3 : 2 };
});
let headingIndex = 0;
const rendered = html.replace(/<h([23])>/g, (_match, level) => {
  const heading = headings[headingIndex++];
  return heading ? '<h' + level + ' id="' + heading.id + '">' : "<h" + level + ">";
});
---
<BaseLayout title="Meet Mark Twain" description="Discover Mark Twain's life, writing, humor, books, and the Mississippi River through practical American English.">
  <article class="section lesson-page" id="top">
    <div class="container">
      <a class="back-link" href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a>
      <div class="lesson-meta">
        <span class="eyebrow">AMERICAN WRITERS</span>
        <span class="source-path">MARK TWAIN · 1835–1910</span>
      </div>
      <figure class="mark-twain-hero">
        <img
          src="https://cdn.loc.gov/service/pnp/npcc/13000/13008v.jpg"
          alt="Historical 1906 portrait print of American writer Mark Twain"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Mark Twain, 1906. Historical print from the Library of Congress, Popular Graphic Arts.
          <a href="https://www.loc.gov/pictures/item/2016839276/" target="_blank" rel="noreferrer">View the original archive record</a>.
        </figcaption>
      </figure>
      <style>
        .mark-twain-hero{max-width:760px;margin:2rem auto 2.5rem}
        .mark-twain-hero img{display:block;width:100%;max-height:560px;object-fit:contain;object-position:center;background:#f4f1e9;border-radius:8px}
        .mark-twain-hero figcaption{margin-top:.65rem;color:#6b7280;font-size:.85rem;line-height:1.55}
        .mark-twain-hero figcaption a{color:#8b6b32;text-decoration:underline;text-underline-offset:3px}
      </style>
      <nav class="lesson-toc" aria-label="Page contents">
        <details>
          <summary>In this feature</summary>
          <ol>
            {headings.map((heading) => (
              <li class:list={{ "toc-subsection": heading.level === 3 }}>
                <a href={"#" + heading.id}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
      <div class="markdown-content" set:html={rendered} />
      <div class="lesson-end"><a href="#top">Back to top ↑</a><a href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a></div>
    </div>
  </article>
</BaseLayout>
