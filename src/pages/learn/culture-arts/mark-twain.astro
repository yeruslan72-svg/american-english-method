---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { marked } from "marked";
import markdown from "../../../content/mark-twain.md?raw";

const html = marked.parse(markdown) as string;
const headings = [...markdown.matchAll(/^#{2,3}\s+(.+)$/gm)].map((match, index) => {
  const text = match[1].trim();
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") + "-" + (index + 1);
  return { text, id, level: match[0].startsWith("###") ? 3 : 2 };
});
let headingIndex = 0;
const rendered = html.replace(/<h([23])>/g, (_match, level) => {
  const heading = headings[headingIndex++];
  return heading ? '<h' + level + ' id="' + heading.id + '">' : "<h" + level + ">";
});
---
<BaseLayout title="Meet Mark Twain" description="Discover Mark Twain's life, writing, humor, books, and the Mississippi River through practical American English.">
  <article class="section lesson-page" id="top">
    <div class="container">
      <a class="back-link" href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a>
      <div class="lesson-meta">
        <span class="eyebrow">AMERICAN WRITERS</span>
        <span class="source-path">MARK TWAIN · 1835–1910</span>
      </div>
      <figure class="mark-twain-hero">
        <img
          src="https://cdn.loc.gov/service/pnp/npcc/13000/13008v.jpg"
          alt="Historical 1906 portrait print of American writer Mark Twain"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Mark Twain, 1906. Historical print from the Library of Congress, Popular Graphic Arts.
          <a href="https://www.loc.gov/pictures/item/2016839276/" target="_blank" rel="noreferrer">View the original archive record</a>.
        </figcaption>
      </figure>
      <style>
        .mark-twain-hero{max-width:760px;margin:2rem auto 2.5rem}
        .mark-twain-hero img{display:block;width:100%;max-height:560px;object-fit:contain;object-position:center;background:#f4f1e9;border-radius:8px}
        .mark-twain-hero figcaption{margin-top:.65rem;color:#6b7280;font-size:.85rem;line-height:1.55}
        .mark-twain-hero figcaption a{color:#8b6b32;text-decoration:underline;text-underline-offset:3px}
        .twain-gallery{max-width:1050px;margin:3.5rem auto}
        .twain-gallery h2{text-align:center;margin-bottom:.6rem}
        .gallery-intro,.gallery-note{max-width:760px;margin:0 auto 1.5rem;text-align:center;color:#6b7280;line-height:1.65}
        .twain-gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.35rem;align-items:start}
        .twain-gallery-grid figure{margin:0;min-width:0}
        .twain-gallery-grid img{display:block;width:100%;height:280px;object-fit:contain;background:#f4f1e9;border-radius:7px}
        .twain-gallery-grid figcaption{padding:.75rem .15rem 0;color:#6b7280;font-size:.85rem;line-height:1.6}
        .twain-gallery-grid figcaption strong{display:block;color:var(--color-text, #273244);margin-bottom:.35rem}
        .twain-gallery-grid figcaption a{display:inline-block;margin-top:.35rem;color:#8b6b32;text-decoration:underline;text-underline-offset:3px}
        .gallery-note{font-size:.8rem;margin-top:1.25rem}
        @media(max-width:760px){.twain-gallery-grid{grid-template-columns:1fr;gap:1.8rem}.twain-gallery-grid img{height:auto;max-height:360px}.twain-gallery-grid figure{max-width:560px;margin:0 auto;width:100%}}

      </style>
      <section class="twain-gallery" aria-labelledby="twain-gallery-title">
        <h2 id="twain-gallery-title">Characters from Mark Twain's Fiction</h2>
        <p class="gallery-intro">
          These archival illustrations come from early editions of Twain's books. They show how readers first encountered
          some of his fictional world through the work of nineteenth-century illustrators.
        </p>
        <div class="twain-gallery-grid">
          <figure>
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/1c/Adventures_of_Tom_Sawyer-pg038.png/960px-Adventures_of_Tom_Sawyer-pg038.png"
              alt="A lively scene from the 1876 first edition of The Adventures of Tom Sawyer, illustrated by True Williams"
              loading="lazy"
            />
            <figcaption>
              <strong><em>The Adventures of Tom Sawyer</em> — an early scene</strong>
              Illustration by True Williams, from the first American edition, 1876. The original book contains a large
              series of Williams's drawings that shaped the first visual image of Tom's world.
              <a href="https://commons.wikimedia.org/wiki/File:Adventures_of_Tom_Sawyer-pg038.png" target="_blank" rel="noreferrer">Image source &amp; rights</a>.
            </figcaption>
          </figure>
          <figure>
            <img
              src="https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Adventures_of_Tom_Sawyer-pg188.png/500px-Adventures_of_Tom_Sawyer-pg188.png"
              alt="A character resting in bed, from True Williams's 1876 illustrations for The Adventures of Tom Sawyer"
              loading="lazy"
            />
            <figcaption>
              <strong><em>The Adventures of Tom Sawyer</em> — a quiet moment</strong>
              Illustration by True Williams, 1876. This is a scanned illustration from the original book, presented
              as a period interpretation rather than a modern character portrait.
              <a href="https://commons.wikimedia.org/wiki/File:Adventures_of_Tom_Sawyer-pg188.png" target="_blank" rel="noreferrer">Image source &amp; rights</a>.
            </figcaption>
          </figure>
          <figure>
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/a/a0/Huck_and_jim_on_raft.jpg"
              alt="Huckleberry Finn and Jim together on their raft, in an illustration by E. W. Kemble"
              loading="lazy"
            />
            <figcaption>
              <strong>Huckleberry Finn &amp; Jim — <em>Adventures of Huckleberry Finn</em></strong>
              Illustration by E. W. Kemble for the 1884 edition. Huck and Jim share the raft as they travel down the
              Mississippi. The image is a historical interpretation from the book's early illustrated editions.
              <a href="https://commons.wikimedia.org/wiki/File:Huck_and_jim_on_raft.jpg" target="_blank" rel="noreferrer">Image source &amp; rights</a>.
            </figcaption>
          </figure>
        </div>
        <p class="gallery-note">
          Rights note: these nineteenth-century illustrations are identified by their source pages as public domain.
          Copyright terms can differ by country; check local rules before reusing the images.
        </p>
      </section>
      <nav class="lesson-toc" aria-label="Page contents">
        <details>
          <summary>In this feature</summary>
          <ol>
            {headings.map((heading) => (
              <li class:list={{ "toc-subsection": heading.level === 3 }}>
                <a href={"#" + heading.id}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
      <div class="markdown-content" set:html={rendered} />
      <div class="lesson-end"><a href="#top">Back to top ↑</a><a href="/american-english-method/learn/culture-arts/">← American Culture & Arts</a></div>
    </div>
  </article>
</BaseLayout>
